      "html": "<a class=\"ds-card\" href=\"#project\"><h2>Selected project</h2><p>Project description</p></a>",
      "css": ".ds-card{font-family:'IBM Plex Sans',sans-serif;display:flex;flex-direction:column;min-width:0;padding:18px;border:1px solid #33333b;border-radius:6px;background:#1b1b20;color:#f5f5f7;text-decoration:none;overflow:hidden;transition:border-color .18s,background .18s,transform .18s}.ds-card h2{margin:0 0 10px;font-size:21px;font-weight:500;letter-spacing:-.5px;line-height:1.25}.ds-card p{margin:0;font-size:15px;line-height:1.75;color:#a9a9b4}.ds-card:hover{border-color:#70707c;background:#202026;color:#fff;transform:translateY(-2px)}.ds-card:focus-visible{outline:2px solid var(--os-accent);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-card{transition:none}.ds-card:hover{transform:none}}"
    }

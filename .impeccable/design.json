  "narrative": {
    "northStar": "Eclipse",
    "overview": "Eclipse is a personal desktop informed by Unix desktop customization and dark fantasy. Charcoal windows sit over static artwork, with compact shell controls and readable app content.\n\nIBM Plex Sans carries reading content. IBM Plex Mono identifies shell chrome and terminal output. Crimson marks interaction and selection while photographs, diagrams, and project screenshots retain their original colors.",
    "keyCharacteristics": [
      "Dark chrome and fine borders separate windows from artwork.",
      "Compact controls leave room for content.",
      "Motion respects both the interface setting and reduced-motion preferences."
    ],
    "rules": [
      {
        "name": "The Restrained Crimson Rule",
        "body": "Bright red occupies a small part of the interface and identifies interaction or selection.",
        "section": "colors"
      },
      {
        "name": "The Original Color Rule",
        "body": "Artwork, photographs, diagrams, and project screenshots retain their original colors.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do use IBM Plex Sans for reading and IBM Plex Mono for shell chrome and terminal output.",
      "Do preserve the original colors of artwork and content media.",
      "Do keep keyboard focus visible and honor both motion controls."
    ],
    "donts": [
      "Don't introduce a light theme or a theme selector.",
      "Don't animate the wallpapers.",
      "Don't make essential controls depend on gestures alone."
    ]
  }

      "description": "Crimson app action.",
      "html": "<button class=\"ds-primary\">Open Terminal</button>",
      "css": ".ds-primary{font-family:'IBM Plex Sans',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:40px;padding:10px 14px;border:1px solid #c43543;border-radius:4px;background:var(--os-red);color:#f5f5f7;font-size:14px;cursor:pointer}.ds-primary:hover{background:#ca2938;color:white}.ds-primary:focus-visible{outline:2px solid var(--os-accent);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:default}@media(pointer:coarse){.ds-primary{min-height:44px}}"
    },

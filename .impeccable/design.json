      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Charcoal app action.",
      "html": "<button class=\"ds-secondary\">Contact</button>",
      "css": ".ds-secondary{font-family:'IBM Plex Sans',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:40px;padding:10px 14px;border:1px solid #36363e;border-radius:4px;background:#202025;color:#f5f5f7;font-size:14px;cursor:pointer}.ds-secondary:focus-visible{outline:2px solid var(--os-accent);outline-offset:3px;}.ds-secondary:disabled{opacity:.5;cursor:default}@media(pointer:coarse){.ds-secondary{min-height:44px}}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search",
      "description": "Search field with focus-within border feedback.",
      "html": "<label class=\"ds-search\"><input aria-label=\"Search projects\" placeholder=\"Search projects\" /></label>",
      "css": ".ds-search{font-family:'IBM Plex Sans',sans-serif;display:flex;align-items:center;gap:10px;min-width:0;border:1px solid #37373f;border-radius:5px;background:#101013;color:#93939f;padding:0 13px;transition:border-color .15s}.ds-search:focus-within{border-color:#b94a58}.ds-search input{font-family:'IBM Plex Sans',sans-serif;width:100%;min-width:0;background:none;border:0;color:#f5f5f7;padding:11px 0;font-size:15px;outline:none}.ds-search input:focus-visible{outline:none}.ds-search input::placeholder{color:#83838e}@media(pointer:coarse){.ds-search input{min-height:44px}}@media(prefers-reduced-motion:reduce){.ds-search{transition:none}}"
    },
    {
      "name": "Workspace navigation",
      "kind": "nav",
      "description": "Mono workspace tabs with a selected crimson fill.",
      "html": "<nav class=\"ds-workspaces\" aria-label=\"Views\"><button aria-current=\"page\">Desktop</button><button>Projects</button></nav>",
      "css": ".ds-workspaces{display:flex;gap:4px;padding:3px;background:#05070a70;border:1px solid #ffffff08;border-radius:8px}.ds-workspaces button{font-family:'IBM Plex Mono',Consolas,monospace;min-width:84px;min-height:30px;padding:0 12px;border:0;border-radius:5px;background:transparent;color:#b8afb2;font-size:12px;transition:background 160ms,color 160ms;cursor:pointer}.ds-workspaces button[aria-current]{background:#b72c3c;color:#fff;box-shadow:0 2px 8px #0003,inset 0 1px #ffffff18}.ds-workspaces button:hover{background:#ffffff0c;color:#fff}.ds-workspaces button:focus-visible{outline:2px solid var(--os-accent);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-workspaces button{transition:none}}"
